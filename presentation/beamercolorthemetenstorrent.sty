% Gemini theme - Tenstorrent color scheme
% https://github.com/anishathalye/gemini
%
% Colors extracted from the live tenstorrent.com homepage (2026-06-04)
% via frequency analysis of inline hex codes in the rendered HTML.
% See presentation/THEME_NOTES.md for the audit trail and discrepancies.

% ====================
% Definitions
% ====================

% Primary palette --- pulled from tenstorrent.com (homepage, 2026-06-04).
% These are the four highest-frequency hex codes in the rendered HTML.
\definecolor{ttdarkteal}{HTML}{335C4B}   % primary brand --- headers, structure, item bullets
\definecolor{ttnearblack}{HTML}{1B3527}  % deepest accent --- separators, headline rule
\definecolor{ttcream}{HTML}{EEEAE0}      % off-white page tone --- block bodies
\definecolor{ttgold}{HTML}{EDBE5A}       % warm accent --- alerted-block tint, callouts

% Secondary accent --- the recurring TT cyan/blue on hardware product pages
% (Blackhole page, /hardware/blackhole, same audit). Lower frequency on the
% homepage but it is the most product-identifying accent across the site.
\definecolor{ttcyan}{HTML}{3EB7DE}       % example-block accent

% Extra tones for the alert/example backgrounds, derived by lightening
% the brand palette toward ttcream so block bodies stay readable.
\definecolor{ttlightgray}{RGB}{240, 240, 240}
\definecolor{ttlightgold}{HTML}{FAF1DE}  % gold washed toward cream
\definecolor{ttlightteal}{HTML}{CFEEE8}  % observed on tenstorrent.com (light teal tint)

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=ttnearblack,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=ttdarkteal}

% Headline
\setbeamercolor{headline}{fg=ttcream,bg=ttdarkteal}
\setbeamercolor{headline rule}{bg=ttnearblack}

% Block
\setbeamercolor{block title}{fg=ttdarkteal,bg=white}
\setbeamercolor{block separator}{bg=ttnearblack}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block (warm gold accent)
\setbeamercolor{block title alerted}{fg=ttnearblack,bg=ttlightgold}
\setbeamercolor{block separator alerted}{bg=ttgold}
\setbeamercolor{block body alerted}{fg=black,bg=ttlightgold}

% Example Block (cyan accent --- the TT product cyan)
\setbeamercolor{block title example}{fg=ttdarkteal,bg=ttlightteal}
\setbeamercolor{block separator example}{bg=ttcyan}
\setbeamercolor{block body example}{fg=black,bg=ttlightteal}

% Heading
\setbeamercolor{heading}{fg=ttnearblack}

% Itemize
\setbeamercolor{item}{fg=ttdarkteal}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
