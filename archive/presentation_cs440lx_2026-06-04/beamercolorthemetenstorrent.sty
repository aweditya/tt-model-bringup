% Gemini theme - Tenstorrent color scheme
% https://github.com/anishathalye/gemini
%
% Palette derived from tenstorrent.com's "Buy Blackhole" CTA button
% (light sky blue) plus the cream + ink (near-black green) tones used
% across the marketing pages.

% ====================
% Definitions
% ====================

% Primary palette
\definecolor{ttsky}{HTML}{8FC6E8}        % CTA sky blue --- block titles, separators, rules
\definecolor{ttdeepblue}{HTML}{3A78A6}   % darker shade --- headline text, structural fg
\definecolor{ttcream}{HTML}{EEEAE0}      % page tone --- block bodies / headline bg
\definecolor{ttink}{HTML}{1B3527}        % near-black green --- body text

% Light tints derived from the primary blue for example/alert backgrounds.
\definecolor{ttskytint}{HTML}{DDEEF8}    % sky washed toward cream
\definecolor{ttgold}{HTML}{EDBE5A}       % warm accent --- alerted block tint
\definecolor{ttlightgold}{HTML}{FAF1DE}  % gold washed toward cream
\definecolor{ttlightgray}{RGB}{240, 240, 240}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=ttdeepblue,bg=ttcream}
\setbeamercolor{palette secondary}{fg=ttink,bg=ttcream}
\setbeamercolor{palette tertiary}{bg=ttdeepblue,fg=ttcream}
\setbeamercolor{palette quaternary}{fg=ttink,bg=ttcream}
\setbeamercolor{structure}{fg=ttdeepblue}

% Headline --- deep blue band with cream text
\setbeamercolor{headline}{fg=ttcream,bg=ttdeepblue}
\setbeamercolor{headline rule}{bg=ttsky}

% Normal text --- ink on cream page
\setbeamercolor{normal text}{fg=ttink,bg=ttcream}
\setbeamercolor{background canvas}{bg=ttcream}

% Block --- sky-blue title bar over ink-on-cream body
\setbeamercolor{block title}{fg=ttink,bg=ttsky}
\setbeamercolor{block separator}{bg=ttdeepblue}
\setbeamercolor{block body}{fg=ttink,bg=ttcream}

% Alert Block (warm gold accent)
\setbeamercolor{block title alerted}{fg=ttink,bg=ttlightgold}
\setbeamercolor{block separator alerted}{bg=ttgold}
\setbeamercolor{block body alerted}{fg=ttink,bg=ttlightgold}

% Example Block (light sky tint)
\setbeamercolor{block title example}{fg=ttdeepblue,bg=ttskytint}
\setbeamercolor{block separator example}{bg=ttsky}
\setbeamercolor{block body example}{fg=ttink,bg=ttskytint}

% Heading
\setbeamercolor{heading}{fg=ttdeepblue}

% Itemize bullets in sky blue for accent
\setbeamercolor{item}{fg=ttdeepblue}

% Bibliography
\setbeamercolor{bibliography item}{fg=ttink}
\setbeamercolor{bibliography entry author}{fg=ttink}
\setbeamercolor{bibliography entry title}{fg=ttink}
\setbeamercolor{bibliography entry location}{fg=ttink}
\setbeamercolor{bibliography entry note}{fg=ttink}
