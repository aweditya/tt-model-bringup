# tt-model-bringup environment template.
# Copy to `.env` and fill in your values:   cp .env.example .env
# The `.env` file is gitignored — do NOT commit real tokens.
#
# Most env vars below have working defaults baked into
# experiments/serve/scripts/serve.sh and serve_tp.sh; setting them here
# only matters when you want to override the defaults explicitly.

# ---------------------------------------------------------------------------
# HuggingFace authentication.
# Required to download Qwen/Qwen3.6-27B weights and tokenizer.
# Alternative: run `uv run huggingface-cli login` once; that writes
# ~/.cache/huggingface/token, and transformers/huggingface_hub auto-detect
# it without needing this env var. Either path works.
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# TT-Metal source build paths. The TP serve script expects these.
# Defaults assume you cloned tt-metal under $HOME/tenstorrent/tt-metal and
# built into the tracy/gcc12 variant — adjust to your tree.
# ---------------------------------------------------------------------------
TT_METAL_HOME=$HOME/tenstorrent/tt-metal
TT_BUILD_DIR=$TT_METAL_HOME/build_tracy_gcc12_nodist

# ---------------------------------------------------------------------------
# Required by ttnn at runtime — selects the Blackhole codegen path.
# Don't change this; leave it for documentation.
# ---------------------------------------------------------------------------
ARCH_NAME=blackhole

# ---------------------------------------------------------------------------
# Optional. Where huggingface_hub stores weights/tokenizers.
# Defaults to $PROJECT_ROOT/.cache/hf (see serve.sh / serve_tp.sh).
# Override if your $HOME has limited disk and you want HF to spill elsewhere.
# ---------------------------------------------------------------------------
# HF_HOME=$HOME/tt-xla/.cache/hf

# ---------------------------------------------------------------------------
# Optional. Cap num_layers loaded by server_tp.py — useful for short
# correctness probes (e.g. TP_MAX_LAYERS=4) that don't need the full
# 64-block decode stack. Leave unset for production.
# ---------------------------------------------------------------------------
# TP_MAX_LAYERS=
